# Copy to .env and change every secret before exposing the stack.
MONXU_ENV=development
POSTGRES_PASSWORD=change-me-postgres
MONXU_SECRET_KEY=change-me-to-a-long-random-string-at-least-48-chars
MONXU_COOKIE_SECURE=0            # 1 behind HTTPS
MONXU_CORS_ORIGINS=http://localhost:3000
MONXU_SEED_DEMO=1                # loads the Monxu Manufacturing demo tenant (ignored in production)
MONXU_LOG_JSON=1
MONXU_RATE_LIMIT_PER_MINUTE=600
# Optional OIDC single sign-on
MONXU_OIDC_ISSUER=
MONXU_OIDC_AUDIENCE=
MONXU_OIDC_JWKS_URL=
# Optional: language-model mode of the planning assistant (answers stay grounded in plan data)
MONXU_ASSISTANT_LLM=0
ANTHROPIC_API_KEY=
